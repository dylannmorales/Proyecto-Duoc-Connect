# Configuración local de Duoc Connect.
# La leen Docker Compose (docker compose up) y el backend en desarrollo (mvn spring-boot:run).
# Las variables de entorno del sistema tienen prioridad sobre este archivo.
#
# ⚠️ Este archivo SÍ se sube al repositorio (que es público). No pongas aquí claves reales de AWS
#    ni contraseñas de producción: AWS bloquea las claves que detecta publicadas en GitHub.

# PostgreSQL (contenedor de Docker)
POSTGRES_DB=duoc_connect
POSTGRES_USER=duoc
POSTGRES_PASSWORD=duoc_secret
# Puerto del equipo donde se publica la BD. Se usa 5433 para no chocar con un PostgreSQL
# instalado en el equipo (que suele ocupar el 5432).
POSTGRES_PORT=5433
# Volumen de Docker con los datos de la BD.
POSTGRES_VOLUME=duoc-connect_postgres_data

# Backend
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/duoc_connect
JWT_SECRET=change-me-to-a-secure-random-string-at-least-256-bits-long
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
FRONTEND_URL=http://localhost:5173

# Frontend
VITE_API_URL=http://localhost:8080/api/v1

# AWS S3 para los PDF de apuntes. Con AWS_S3_ENABLED=false se guardan en disco (./uploads).
# Para activarlo: completa las claves del usuario IAM y cambia AWS_S3_ENABLED a true.
AWS_S3_ENABLED=false
AWS_S3_BUCKET=duoc-connect
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Administrador inicial (en dev la contraseña de demo es Admin1234; en prod es obligatoria)
ADMIN_EMAIL=admin@duocuc.cl
ADMIN_PASSWORD=Admin1234
